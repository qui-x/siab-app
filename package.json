{
  "name": "siab",
  "version": "1.0.0",
  "description": "SIAB - Simulador Interativo de Ácidos e Bases",
  "main": "main.js",
  "author": "qui-x",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win nsis portable msi --x64 --publish never",
    "build:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "build": {
    "appId": "io.github.quix.siab",
    "productName": "SIAB",
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "msi"
      ],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "SIAB-portatil.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SIAB-instalador.exe"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SIAB-instalador.msi"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Education",
      "artifactName": "SIAB-linux.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  },
  "dependencies": {}
}